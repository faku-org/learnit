# Port the API listens on. Must match PUBLIC_API_PORT in the root .env,
# which is what the frontend calls.
PORT=3001

# Deepseek API key — get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# xAI API key — get one at https://console.x.ai/
# Powers the Speak page: TTS (/v1/tts), STT (/v1/stt), and the live
# Speech-to-Speech conversation in Scenario mode (/v1/realtime).
XAI_API_KEY=xai-...

# MongoDB connection string (default works for a local instance)
MONGO_URI=mongodb://localhost:27017

# Database name
DB_NAME=learnit

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Without these the sign-in button redirects to a Google error page instead of
# the account picker, because client_id comes through empty.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Must be registered verbatim as an authorized redirect URI in the console.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Where the API sends the browser back after a successful login.
APP_URL=http://localhost:4321

# Key for encryption at rest (account email, TOTP secret) and for signing the
# two-step challenge: 32 bytes as 64 hex chars, base64 or base64url
# (`openssl rand -hex 32`). In production put it in a file outside the repo and
# set LEARNIT_SECRET_KEY_FILE to its path. Without a key, email and 2FA are
# off (they fail closed); register and login with a password keep working.
LEARNIT_SECRET_KEY=
# LEARNIT_SECRET_KEY_FILE=

# Development over http:// only: lets the session cookie travel without Secure.
# Never set it in production.
LEARNIT_INSECURE_COOKIES=true
