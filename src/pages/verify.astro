---
// OAuth callback — receives ?jwt=<signed-token> from the API after Google OAuth
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Signing in... — LearnIt!</title>
    <style>
      body {
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        font-family: sans-serif;
        background: #0a0a0a;
        color: #e5e5e5;
      }
      .container { text-align: center; }
      .spinner {
        width: 32px; height: 32px;
        border: 2px solid #333;
        border-top-color: #7c3aed;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        margin: 0 auto 16px;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      .error { color: #f87171; margin-top: 8px; font-size: 14px; }
      .link { color: #7c3aed; text-decoration: none; }
    </style>
  </head>
  <body>
    <div class="container" id="root">
      <div class="spinner"></div>
      <p id="signing-in-text">Signing you in...</p>
    </div>

    <script>
      const STRINGS = {
        en: {
          signingIn: "Signing you in...",
          signInFailed: "Sign-in failed",
          goBack: "Go back",
          cancelled: "Sign-in was cancelled.",
          googleFailed: "Google sign-in failed. Please try again.",
          noToken: "No token found.",
          invalidToken: "Invalid token. Please try signing in again.",
        },
        es: {
          signingIn: "Iniciando sesión...",
          signInFailed: "Error al iniciar sesión",
          goBack: "Volver",
          cancelled: "El inicio de sesión fue cancelado.",
          googleFailed: "Falló el inicio de sesión con Google. Intenta de nuevo.",
          noToken: "No se encontró el token.",
          invalidToken: "Token inválido. Intenta iniciar sesión de nuevo.",
        },
      } as const;

      const stored = localStorage.getItem("learnit_locale");
      const locale =
        stored === "en" || stored === "es"
          ? stored
          : navigator.language.slice(0, 2) === "es"
            ? "es"
            : "en";
      const t = STRINGS[locale];
      document.documentElement.lang = locale;
      document.getElementById("signing-in-text")!.textContent = t.signingIn;

      function decodeJWTPayload(token: string): Record<string, unknown> {
        const [, payload] = token.split(".");
        return JSON.parse(atob(payload.replace(/-/g, "+").replace(/_/g, "/")));
      }

      function showError(msg: string) {
        const root = document.getElementById("root")!;
        root.innerHTML = `
          <p style="font-size:18px;margin-bottom:8px">${t.signInFailed}</p>
          <p class="error">${msg}</p>
          <p style="margin-top:16px;font-size:14px">
            <a class="link" href="/">${t.goBack}</a>
          </p>
        `;
      }

      const params = new URLSearchParams(window.location.search);
      const jwt = params.get("jwt");
      const authError = params.get("auth_error");

      if (authError) {
        showError(authError === "denied" ? t.cancelled : t.googleFailed);
      } else if (!jwt) {
        showError(t.noToken);
      } else {
        try {
          const payload = decodeJWTPayload(jwt);
          localStorage.setItem("learnit_token", jwt);
          localStorage.setItem(
            "learnit_user",
            JSON.stringify({ userId: payload.userId, email: payload.email }),
          );
          window.location.href = "/learn";
        } catch {
          showError(t.invalidToken);
        }
      }
    </script>
  </body>
</html>
